{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with authentication details.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "TranscriptSegment": {
      "title": "TranscriptSegment",
      "description": "A verbatim segment of a video transcript.",
      "type": "object",
      "properties": {
        "start": { "type": "number" },
        "duration": { "type": "number" },
        "text": { "type": "string" }
      }
    },
    "Project": {
      "title": "Project",
      "description": "A video analysis project belonging to a user.",
      "type": "object",
      "properties": {
        "videoId": { "type": "string" },
        "title": { "type": "string" },
        "duration": { "type": "number" },
        "ownerId": { "type": "string" },
        "transcripts": {
          "type": "array",
          "items": { "$ref": "TranscriptSegment" }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["videoId", "ownerId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public user profiles."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "User video projects containing verbatim data."
    }
  }
}
